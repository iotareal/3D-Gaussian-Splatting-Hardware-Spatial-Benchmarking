# --- only push results.json
# 1. Ignore everything inside the output folder recursively
output/**/*

# 2. Allow Git to "look" into subdirectories (required to find the file)
!output/**/
output/**/point_cloud
output/**/test

# 3. Whitelist ONLY the results.json files
!output/**/results.json


# Remove the .pkl file
*.pkl

